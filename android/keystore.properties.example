# Copy this file to keystore.properties and fill in your values.
# Do NOT commit keystore.properties to version control.
#
# To create a keystore:
#   keytool -genkey -v -keystore click-to-call.jks -keyalg RSA -keysize 2048 -validity 10000 -alias clicktocall

storeFile=click-to-call.jks
storePassword=
keyAlias=clicktocall
keyPassword=
